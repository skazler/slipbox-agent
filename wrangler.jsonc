{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slipbox-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "vars": {
    "GITHUB_REPO": "skazler/obsidian-vault",
    "GITHUB_BRANCH": "main",
    "TIMEZONE": "America/Chicago",
    // Local wall-clock hours the jobs should fire at.
    "DAILY_HOUR": "20",
    "DAILY_MINUTE": "45",
    "WEEKLY_HOUR": "9",
    "WEEKLY_MINUTE": "0",
    "WEEKLY_WEEKDAY": "Sat",
    // Ported from Hermes: the 19:00 gratitude prompt and the 05:00 news
    // digest. Both were `agent`-mode jobs posting to Discord.
    "GRATITUDE_HOUR": "19",
    "GRATITUDE_MINUTE": "0",
    "REFLECT_HOUR": "19",
    "REFLECT_MINUTE": "30",
    "REFLECT_WEEKDAY": "Sun",
    "NEWS_HOUR": "5",
    "NEWS_MINUTE": "0"
  },

  "triggers": {
    // Cron is UTC-only, so each job is scheduled at BOTH its CDT and CST
    // UTC hour; the handler checks local wall-clock time and no-ops on the
    // one that doesn't match. This keeps the local times stable across DST.
    "crons": [
      "45 1,2 * * *",   // daily 20:45 America/Chicago
      "0 14,15 * * 6",  // Saturday 09:00 America/Chicago
      "0 0,1 * * *",    // gratitude prompt 19:00 America/Chicago
      // Sunday 19:30 local lands on MONDAY in UTC — hence the `1`, not `0`.
      "30 0,1 * * 1",   // weekly reflection prompt Sun 19:30 America/Chicago
      "0 10,11 * * *"   // news digest 05:00 America/Chicago
    ]
  }

  // Secrets (set with `wrangler secret put <NAME>`, never in this file):
  //   ANTHROPIC_API_KEY
  //   GITHUB_TOKEN          fine-grained PAT, Contents: Read and write
  //   DISCORD_WEBHOOK_URL   channel webhook the reviews are posted to
  //   DISCORD_PUBLIC_KEY    app's Ed25519 public key, verifies interactions
  //   DISCORD_USER_ID       your user id; anyone else's /note is rejected
}
