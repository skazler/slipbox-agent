{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slipbox-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "vars": {
    "GITHUB_REPO": "skazler/obsidian-vault",
    "GITHUB_BRANCH": "main",
    "TIMEZONE": "America/Chicago",
    // Local wall-clock hours the jobs should fire at.
    // Ported from Hermes: the 19:00 gratitude prompt.
    "GRATITUDE_HOUR": "19",
    "GRATITUDE_MINUTE": "0",
    "REFLECT_HOUR": "19",
    "REFLECT_MINUTE": "30",
    "REFLECT_WEEKDAY": "Sun",
    // Daily 05:30: the value goal from the latest /reflect, verbatim.
    "VALUE_HOUR": "5",
    "VALUE_MINUTE": "30",
    // Weekly zettel roll-up, Sat 00:00: every live Inbox/ file dated before
    // today is copied verbatim into Journal/Zettels Review.md, then moved to Inbox/archive/.
    "ZETTELS_HOUR": "0",
    "ZETTELS_MINUTE": "0",
    "ZETTELS_WEEKDAY": "Sat"
  },

  "triggers": {
    // One tick every 15 minutes; the handler matches local wall-clock time
    // against the vars above and no-ops on the ~90 ticks a day that aren't a
    // job time. Every scheduled time lands on a quarter hour, so the grid
    // covers all of them.
    //
    // This replaced a per-job cron pair. Cron is UTC-only, so each job used to
    // be registered at BOTH its CDT and CST hour with the handler discarding
    // the wrong one — 5 expressions for 5 jobs, against an account cap of 5 on
    // the free plan, and adding the reminder would have needed 4 more. Ticking
    // on a fixed grid costs one expression no matter how many jobs there are,
    // and DST stops being represented in this file at all.
    "crons": ["0,15,30,45 * * * *"]
  }

  // Secrets (set with `wrangler secret put <NAME>`, never in this file):
  //   GITHUB_TOKEN               fine-grained PAT, Contents: Read and write
  //   DISCORD_WEBHOOK_LEARNING   #learning — zettel roll-up notice, journal nudges, value reminder
  //   DISCORD_PUBLIC_KEY         app's Ed25519 public key, verifies interactions
  //   DISCORD_USER_ID            your user id; anyone else's /zettel is rejected
}
